# Application server only. Supply real values in .env.local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_REALTIME_SECRET=
NEON_REALTIME_URL=
NEON_REALTIME_DATABASE_NAME=neondb

# Browser-visible WebSocket URL. Same value as NEON_REALTIME_URL.
NEXT_PUBLIC_NEON_REALTIME_URL=

# Local tooling only. Never prefix these with NEXT_PUBLIC_.
# Setting the profile alone does not select staging: both hosts are required.
NEON_API_HOST=https://console-stage.neon.build/api/v2
NEON_OAUTH_HOST=https://oauth2-stage.neon.build

# Optional override for scripts that build packages from a local checkout.
# The implementation will accept a portable path instead of hardcoding one.
NEON_PKGS_DIR=

# Dedicated ingestion target. Policy defaults to disabled on every branch.
NEON_PROFILE=staging
INGEST_PROJECT_ID=
INGEST_BRANCH_ID=
ENABLE_INGEST=0
# Observed staging configuration: two-minute tenure, four-minute absolute request.
INGEST_REQUEST_BUDGET_MS=240000
INGEST_TENURE_MS=120000
INGEST_OVERLAP_MS=90000
# Spread upstream bursts over this window; 0 publishes immediately (max 60000).
INGEST_SMOOTHING_MS=28000
# Exact deployed browser origin, set before deploying Neon policy.
DEMO_ORIGIN=
DEMO_ADDITIONAL_ORIGINS=
NEXT_PUBLIC_MEASURE_REALTIME=0
# Explicit development-only fixture; never used by a production build.
HN_FIXTURE=0
